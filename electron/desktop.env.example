# Copy to one of:
#   - %APPDATA%/Accounting AI/desktop.env          (Windows, after first launch)
#   - ~/Library/Application Support/Accounting AI/desktop.env  (macOS)
#   - project-root/desktop.env                     (dev)
#   - resources/desktop.env                        (next to packaged resources)
#
# Existing process environment variables always win over this file.
# Do not commit real values.

# Optional host OpenAI key for server-side extract fallback
# OPENAI_API_KEY=

# Firebase web config (same names as the web app — no VITE_/NEXT_PUBLIC_ prefixes)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
